# Copy to ai/.env (gitignored). Do not commit or paste real credentials.
GMS_KEY=
AI_INTERNAL_TOKEN=
# Document review: HTTPS gms.ssafy.io only, optional port 443; the path must
# end in /chat/completions. Userinfo, query strings and fragments are rejected.
GMS_CHAT_ENDPOINT=https://gms.ssafy.io/gmsapi/api.openai.com/v1/chat/completions

# Optional: json_schema only when the configured provider/model supports strict output.
VALIDATION_RESPONSE_FORMAT=json_object

GMS_EMBEDDING_MODEL=text-embedding-3-small
# Initial AI configuration; BE must use the same model/dimension before indexing.
GMS_EMBEDDING_DIMENSION=1024

# Selected for the later Bibi generation task; #129 does not call these models.
BEE_DEFAULT_MODEL=gpt-6-luna
BEE_COMPLEX_MODEL=gpt-6.1-sol

# Enable only after BE accepts and persists DESIGN_RECOMMENDATION usage.
DESIGN_RECOMMENDATION_ENABLED=false

# Assignment suggestions (#136): opt in only after the BE/AI contract and
# workload snapshot responsibilities are agreed. No assignments are written.
# Planning analysis (기획 분석): clarifying questions (#133) and design drafts
# (#134). Both are off by default and answer 503 until enabled; they call the
# GMS model with GMS_KEY and BEE_DEFAULT_MODEL.
PLANNING_QUESTIONS_ENABLED=false
DESIGN_DRAFTS_ENABLED=false
# Output token caps include the model's reasoning tokens. Defaults were measured
# on real documents (S15P31A108-388): questions 8192 tokens / 90 s (allowed
# 1-16384 / 0-240), drafts 16384 tokens / 150 s (allowed 1-32768 / 0-240).
# Change them only together with the BE read timeouts, which must stay longer:
# BEEZ_PLANNING_QUESTION_READ_TIMEOUT (default 105s) and
# BEEZ_PLANNING_DRAFT_READ_TIMEOUT (default 170s). A shorter BE limit cuts the
# call (ai_timeout) while the model keeps running and is still billed.
# PLANNING_QUESTIONS_LLM_OUTPUT_TOKEN_LIMIT=8192
# PLANNING_QUESTIONS_LLM_TIMEOUT_SECONDS=90
# DESIGN_DRAFTS_LLM_OUTPUT_TOKEN_LIMIT=16384
# DESIGN_DRAFTS_LLM_TIMEOUT_SECONDS=150

# Task generation runs in the BE worker. Output cap includes reasoning tokens.
# Keep the AI limit below BEEZ_TASK_BREAKDOWN_READ_TIMEOUT (default 105s).
TASK_BREAKDOWN_LLM_TIMEOUT_SECONDS=90
TASK_BREAKDOWN_LLM_OUTPUT_TOKEN_LIMIT=16384

# Document review (AI-A10) model-call limits in seconds (0 < value <= 120).
# Review/RERUN runs in the BE worker: keep it below DOCUMENT_REVIEW_WORKER_READ_TIMEOUT (120s).
DOCUMENT_REVIEW_LLM_TIMEOUT_SECONDS=110
# DISCUSS/REQUEST answers inside the user's request: keep it below the BE read timeout
# DOCUMENT_REVIEW_READ_TIMEOUT (55s) and the nginx /api/ read timeout (60s).
DOCUMENT_REVIEW_CHAT_LLM_TIMEOUT_SECONDS=50

# Task plan draft from documents (S15P31A108-385): model-call limit in seconds (0 < value <= 120)
# and positive output token budget (including reasoning; provider limits apply).
# Keep the timeout below the BE read timeout
# TASK_PLAN_DRAFT_READ_TIMEOUT (default 40s) and the nginx /api/ read timeout (60s).
TASK_PLAN_DRAFTS_LLM_TIMEOUT_SECONDS=30
TASK_PLAN_DRAFTS_LLM_OUTPUT_TOKEN_LIMIT=4096
TASK_PLAN_DRAFTS_LLM_OUTPUT_TOKEN_PARAMETER=max_completion_tokens
# Empty value omits reasoning_effort for gateways that do not support it.
TASK_PLAN_DRAFTS_LLM_REASONING_EFFORT=low
# Estimated system + JSON + framing reserve. Uses offline cl100k, not exact model billing tokens.
TASK_PLAN_DRAFTS_INPUT_TOKEN_LIMIT=4096
TASK_PLAN_DRAFTS_INPUT_RESERVE_TOKENS=128
# Concise generation budgets, also checked against the returned JSON.
# These may be lowered within the API schema ceilings; 0 disables candidate lists.
TASK_PLAN_DRAFTS_GOAL_CHARS=160
TASK_PLAN_DRAFTS_APPROACH_CHARS=240
TASK_PLAN_DRAFTS_LIST_ITEMS=3
TASK_PLAN_DRAFTS_LIST_ENTRY_CHARS=100
TASK_PLAN_DRAFTS_EVIDENCE_ITEMS=5
TASK_PLAN_DRAFTS_QUOTE_CHARS=160
TASK_PLAN_DRAFTS_LINK_CANDIDATES=3
TASK_PLAN_DRAFTS_REASON_CHARS=100
TASK_PLAN_DRAFTS_NEW_ITEMS=3
TASK_PLAN_DRAFTS_UNLINKED_ITEMS=3

ASSIGNMENT_RECOMMENDATION_ENABLED=false
ASSIGNMENT_RECOMMENDATION_MAX_BODY_BYTES=2097152
ASSIGNMENT_RECOMMENDATION_TIMEOUT_SECONDS=15
ASSIGNMENT_RECOMMENDATION_OUTPUT_TOKEN_LIMIT=4096

# Change impact analysis (#188). Supply an OpenAI-compatible Chat Completions
# endpoint, key, and model together. Never commit a real key.
IMPACT_LLM_ENDPOINT=
IMPACT_LLM_API_KEY=
IMPACT_LLM_MODEL=
# Keep below BE change-impact read timeout (BEEZ_CHANGE_IMPACT_READ_TIMEOUT, default 75s).
IMPACT_LLM_TIMEOUT_SECONDS=60
# Optional comma-separated response model aliases explicitly trusted by the caller.
IMPACT_LLM_ALLOWED_RESPONSE_MODELS=
# Use max_tokens only for providers/models requiring the legacy option.
IMPACT_LLM_OUTPUT_TOKEN_PARAMETER=max_completion_tokens
# Reasoning tokens count toward this limit (S15P31A108-402).
IMPACT_LLM_OUTPUT_TOKEN_LIMIT=4096
# json_schema requires a provider/model supporting OpenAI strict structured output.
IMPACT_LLM_RESPONSE_FORMAT=json_object
# Per-request limits; excess is rejected before invoking the provider.
IMPACT_MAX_BODY_BYTES=262144
IMPACT_MAX_ITEMS_PER_LIST=100
