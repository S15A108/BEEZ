# 모니터링 스택 로컬 검증 전용 더미값 (S15P31A108-263). 커밋한다 — 서버에 절대 쓰지 않는다.
# 서버 값은 /opt/beez/.env.monitoring 에 있다(docs/infra/monitoring.md "env 파일").

GRAFANA_ADMIN_PASSWORD=local-grafana
MONITOR_DB_PASSWORD=local-monitor-password
# 로컬은 가짜 주소. 서버는 /opt/beez/.alertmanager-webhook-url (monitoring-alerts.md "웹훅 넣기")
ALERTMANAGER_WEBHOOK_URL_FILE=./alertmanager/local-webhook-url
