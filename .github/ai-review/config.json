{
  "project_name": "BEEZ",
  "repo": "S15A108/BEEZ",
  "default_branch": "dev",
  "jira_project": "S15P31A108",
  "model": "opus",
  "effort": "medium",
  "max_findings": 3,
  "claude_timeout": 900,
  "max_diff_chars": 80000,
  "api_id_pattern": "\\b[A-Z]{3}-A\\d{2}\\b",
  "api_specs": ["docs/api/01-backend-rest.md", "docs/api/02-mcp-tools.md", "docs/api/03-ai-internal.md"],
  "code_ext": [".java", ".ts", ".tsx", ".py", ".md"],
  "controller_pattern": "^backend/src/main/java/.*(Controller|Request|Response|Dto)\\.java$",
  "skip_diff": ["^frontend/dist/", "^frontend/public/", "^backend/build/", "^backend/bin/"],
  "routes": [
    {
      "id": "be-api",
      "paths": ["backend/src/main/java/**"],
      "read": ["docs/api/00-common.md", "docs/api/01-backend-rest.md"],
      "update": ["docs/api/01-backend-rest.md"]
    },
    {
      "id": "be-mcp",
      "paths": ["backend/src/main/java/**/mcp/**", "backend/src/main/java/**/agenttoken/**"],
      "read": ["docs/api/02-mcp-tools.md"],
      "update": ["docs/api/02-mcp-tools.md"]
    },
    {
      "id": "ai",
      "paths": ["ai/**", "backend/src/main/java/**/ai/**"],
      "read": ["docs/api/03-ai-internal.md"],
      "update": ["docs/api/03-ai-internal.md"]
    },
    {
      "id": "fe",
      "paths": ["frontend/src/**"],
      "read": ["frontend/CLAUDE.md", "frontend/README.md", "docs/api/00-common.md", "docs/api/01-backend-rest.md"],
      "update": ["frontend/README.md"]
    },
    {
      "id": "infra",
      "paths": ["infra/**", ".github/workflows/**"],
      "read": ["docs/infra/env.md", "docs/infra/cd.md"],
      "update": ["docs/infra/env.md"]
    },
    {
      "id": "collab",
      "paths": ["docs/**"],
      "read": ["docs/collaboration-convention.md"],
      "update": []
    }
  ]
}
